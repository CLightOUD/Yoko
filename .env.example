APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai

DATABASE_PATH=backend/data/app.db

MODEL_PROVIDER=openai
MODEL_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=

FRONTEND_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_DAYS=180
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=yoko_session
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_CHAT_PER_HOUR=120
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
