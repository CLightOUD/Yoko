APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
MAX_REQUEST_BODY_BYTES=8388608

DATABASE_PATH=backend/data/app.db

MODEL_PROVIDER=openai
MODEL_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=

VISION_MODEL_NAME=deepseek-v4-flash-vision-exp
VISION_MODEL_PROVIDER=openai
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com

FRONTEND_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_DAYS=180
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=yoko_session
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=12
RATE_LIMIT_CHAT_PER_HOUR=120
MAX_CONCURRENT_CHAT_REQUESTS=4
WEB_SEARCH_DDG_ENABLED=true
WEB_SEARCH_360_ENABLED=true
PUSH_ENABLED=false
PUSH_POLL_SECONDS=15
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
